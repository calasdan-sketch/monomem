{
  "name": "monomem",
  "version": "1.3.5",
  "mcpName": "io.github.calasdan-sketch/monomem",
  "description": "Shared memory for AI coding agents. A writer on every note (stamped by the server for token callers; a config label for local stdio apps), injection-linted writes, undo for replacements and edits. Self-hosted, MIT.",
  "license": "MIT",
  "author": "Calas Automations Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calasdan-sketch/monomem.git"
  },
  "bugs": {
    "url": "https://github.com/calasdan-sketch/monomem/issues"
  },
  "homepage": "https://github.com/calasdan-sketch/monomem#readme",
  "keywords": [
    "mcp",
    "memory",
    "ai-agents",
    "claude",
    "cursor",
    "gemini",
    "sqlite",
    "fts5",
    "self-hosted",
    "local-first",
    "provenance",
    "note-store",
    "semantic-search",
    "rest-api"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/start.js",
    "api": "node dist/src/index.js",
    "mcp:stdio": "node dist/src/mcp-stdio.js",
    "mcp:http": "node dist/src/mcp-http.js",
    "doctor": "node dist/src/cli.js doctor",
    "bench": "npm run build && node dist/src/cli.js bench",
    "cli": "node dist/src/cli.js",
    "test": "npm run build && node --test --import ./dist/test/setup-env.js \"dist/test/*.test.js\"",
    "version": "node scripts/sync-plugin-version.mjs",
    "prepublishOnly": "npm run build",
    "demo-gif": "node scripts/record-demo.mjs",
    "runner": "node dist/src/runner-start.js",
    "runner:sign": "node dist/src/runner-sign-start.js"
  },
  "bin": {
    "monomem": "dist/src/cli.js",
    "monomem-mcp": "dist/src/mcp-stdio.js",
    "onememory": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "!dist/src/runner*",
    "!dist/src/bench/competitors",
    "README.md",
    "INSTALL.md",
    "INFRA.md",
    "SECURITY.md",
    "SKILL.md",
    "skills/*/SKILL.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/*.md",
    "bench/scenarios/*.json",
    "!docs/RUNNER.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@hono/node-server": "^2.1.5"
  }
}
