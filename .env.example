# Copy this file to .env and set a strong, random token.
# Generate one, e.g.:  openssl rand -hex 32
MONOMEM_TOKEN=change-me-to-a-long-random-string

# Only when a tunnel (Tailscale, Cloudflare) puts the server under a name: that name, comma-separated for several.
# Without it, requests that arrive under the name are refused with 403 "host not allowed".
# MONOMEM_ALLOWED_HOSTS=mybox.tail1234.ts.net
